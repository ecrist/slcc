{
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(xargs cat:*)",
      "Bash(timeout 30 bash -c 'until docker compose logs app 2>&1 | grep -q \"Ready in\"; do sleep 2; done')",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/memberships)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/about)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/course)",
      "Bash(timeout 30 bash -c 'until docker compose logs app --tail 5 2>&1 | grep -q \"Ready in\"; do sleep 2; done')",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)"
    ]
  }
}
